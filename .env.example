# Copia este archivo como .env, o deja que database/mysql/deploy_205.ps1 lo genere.
# El .env real contiene la contrasena y esta excluido por .gitignore.

# Conexion a MySQL
DATABASE_URL=mysql://cierre_app:TU_PASSWORD@localhost:3306/cierre_operaciones

# Alternativa a DATABASE_URL, por variables sueltas:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cierre_app
# DB_PASSWORD=TU_PASSWORD
# DB_NAME=cierre_operaciones

# Puerto donde se sirven el tablero y la API
PORT=5174

# Solo si algun dia la API se despliega aparte del frontend.
# Por defecto el frontend usa rutas relativas (/api) y no necesita esto.
# VITE_API_URL=http://192.168.20.205:5174/api
